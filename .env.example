# Copy to .env (git-ignored). Never commit real keys.

# --- Walrus Memory (shared account for both parties) ---
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=            # delegate key
# MEMWAL_MODE=auto             # auto | mock | live
# MEMWAL_NAMESPACE=credit-demo
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
#   Mainnet default. Testnet/staging relayer: https://relayer.dev.memwal.ai
# MEMWAL_RECALL_LIMIT=100

# --- Tatum Sui payment rail ---
TATUM_API_KEY=
SUI_AGENT_PRIVATE_KEY=         # hex64 or suiprivkey1...
# SUI_NETWORK=mainnet
# PAYMENT_RECIPIENT=
# PAYMENT_AMOUNT=0.01
# PAYMENT_GAS_BUDGET_MIST=10000000
# PAYMENT_COIN_TYPE=0x2::sui::SUI
# PAYMENT_COIN_DECIMALS=9
# PAYMENT_SYMBOL=SUI

# --- Server ---
# PORT=3000
